+import type { PluginOption, UserConfig } from "vite";
+import type { ViteHubOptions } from "./index.js";
+
+interface NuxtLike {
+  hook?: (name: "nitro:config", callback: (config: Record<string, unknown>) => unknown) => void;
+  options: {
+    dev?: boolean;
+    rootDir?: string;
+    vite?: UserConfig;
+  };
+}
+
+declare function viteHubNuxtModule(options: ViteHubOptions, nuxt?: NuxtLike): void;
+declare function flattenViteHubPlugins(options: ViteHubOptions): PluginOption[];
+
+export { viteHubNuxtModule as default, flattenViteHubPlugins, viteHubNuxtModule };
diff --git a/dist/nuxt.js b/dist/nuxt.js
new file mode 100644
index 0000000000000000000000000000000000000000..9b4bf8b09b1941ae7cee5a8603f9c9322bbacd79
--- /dev/null
+++ b/dist/nuxt.js
@@ -0,0 +1,64 @@
+import { mergeConfig } from "vite";
+import { vitehub } from "./index.js";
+
+function flattenViteHubPlugins(options) {
+  return vitehub(options).flat(Infinity).filter(Boolean);
+}
+
+function configHandler(plugin) {
+  if (typeof plugin.config === "function") return plugin.config;
+  if (plugin.config && typeof plugin.config.handler === "function") return plugin.config.handler;
+}
+
+async function applyViteHubNitroConfig(plugins, nitroConfig, nuxt) {
+  const environment = {
+    command: nuxt.options.dev ? "serve" : "build",
+    isPreview: false,
+    isSsrBuild: true,
+    mode: nuxt.options.dev ? "development" : "production",
+  };
+  let config = {
+    build: {},
+    nitro: nitroConfig,
+    root: nuxt.options.rootDir || process.cwd(),
+    server: {},
+  };
+
+  for (const plugin of plugins) {
+    const handler = configHandler(plugin);
+    if (!handler) continue;
+    const result = await handler.call({}, config, environment);
+    if (result) config = mergeConfig(config, result);
+  }
+
+  if (config.nitro) Object.assign(nitroConfig, config.nitro);
+
+  const d1Bindings = nitroConfig.cloudflare?.wrangler?.d1_databases;
+  if (Array.isArray(d1Bindings)) {
+    const seen = new Set();
+    nitroConfig.cloudflare.wrangler.d1_databases = d1Bindings.filter(binding => {
+      const key = JSON.stringify([binding.binding, binding.database_id, binding.database_name]);
+      if (seen.has(key)) return false;
+      seen.add(key);
+      return true;
+    });
+  }
+}
+
+function viteHubNuxtModule(options, nuxt) {
+  if (!nuxt) return;
+
+  const plugins = flattenViteHubPlugins(options)
+    .filter(plugin => plugin.name !== "vite-hub/deployment-output");
+  nuxt.options.vite ||= {};
+  const existing = Array.isArray(nuxt.options.vite.plugins) ? nuxt.options.vite.plugins : [];
+  const names = new Set(existing.flat(Infinity).map(plugin => plugin?.name).filter(Boolean));
+  nuxt.options.vite.plugins = [
+    ...plugins.filter(plugin => !names.has(plugin.name)),
+    ...existing,
+  ];
+
+  nuxt.hook?.("nitro:config", config => applyViteHubNitroConfig(plugins, config, nuxt));
+}
+
+export { flattenViteHubPlugins, viteHubNuxtModule as default, viteHubNuxtModule };
