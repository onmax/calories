{
  "name": "vitehub-calories",
  "private": true,
  "type": "module",
  "imports": {
    "#vitehub/env/server": {
      "types": "./.vitehub/env/server.d.ts",
      "default": "./.vitehub/env/server.mjs"
    },
    "#vitehub/templates": {
      "types": "./.vitehub/types/templates.d.ts",
      "default": "./.vitehub/markdown-template/templates.mjs"
    }
  },
  "scripts": {
    "build": "node --env-file-if-exists=.env node_modules/nuxt/bin/nuxt.mjs build",
    "deploy": "vp run build && wrangler deploy --config .output/server/wrangler.json",
    "db:generate": "node --env-file-if-exists=.env node_modules/vite-hub/dist/bin.js db generate",
    "db:migrate": "mkdir -p .vitehub/data/database && node --env-file-if-exists=.env node_modules/vite-hub/dist/bin.js db migrate",
    "db:migrate:remote": "vp run build && wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json",
    "dev": "node --env-file-if-exists=.env node_modules/nuxt/bin/nuxt.mjs dev --host 127.0.0.1 --port 3000",
    "postinstall": "vitehub types prepare && nuxt prepare",
    "preview": "node --env-file-if-exists=.env node_modules/nuxt/bin/nuxt.mjs preview",
    "telegram:webhook": "node --env-file=.env node_modules/vite-hub/dist/bin.js channels sync --agent calories --channel telegram --stage production",
    "typecheck": "node --env-file-if-exists=.env node_modules/nuxt/bin/nuxt.mjs typecheck"
  },
  "dependencies": {
    "@internationalized/date": "3.12.2",
    "@nuxt/ui": "4.10.0",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@valibot/to-json-schema": "1.7.1",
    "@vite-hub/database": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/database@671204d",
    "ai": "7.0.34",
    "drizzle-orm": "0.45.2",
    "h3": "2.0.1-rc.25",
    "nuxt": "npm:nuxt-nightly@5.0.0-29746924.1554961a",
    "ofetch": "2.0.0-alpha.3",
    "tailwindcss": "4.3.3",
    "valibot": "1.4.2",
    "vite-hub": "https://pkg.pr.new/vite-hub/vitehub/vite-hub@671204d",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260724.1",
    "@iconify-json/lucide": "1.2.113",
    "@nuxt/icon": "2.5.0",
    "@types/node": "25.9.2",
    "drizzle-kit": "0.31.10",
    "nitro": "3.0.260610-beta",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vue-tsc": "3.2.6",
    "wrangler": "4.111.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
